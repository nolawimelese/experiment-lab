   "source": [
    "import numpy as np\n",
    "rng = np.random.default_rng()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2231bf13",
   "metadata": {},
   "outputs": [],
   "source": [
    "x1 = rng.random(100) * 100\n",
    "# sum of values in array\n",
    "%timeit sum(x1)\n",
    "%timeit np.sum(x1)\n",
    "\n",
    "# min and max of array\n",
    "print(\"min is \", np.min(x1))\n",
    "\n",
    "print(\"max is \", np.max(x1))"
   ]
  }
